# Porta do servidor (opcional, padrão: 3001)
PORT=3001

# Ambiente de execução (opcional)
NODE_ENV=production

# Gemini CLI para sumarização
# Requer o comando `gemini` instalado e autenticado no servidor
GEMINI_CLI_PATH=gemini
# Opcional: deixe vazio para usar o modelo padrão do Gemini CLI
GEMINI_MODEL=
# Timeout por tentativa no Gemini CLI (ms)
GEMINI_TIMEOUT_MS=90000
GEMINI_MAX_ATTEMPTS=3
GEMINI_RETRY_BASE_MS=1200
# Modo de aprovação da CLI (`plan` recomendado para servidor/headless)
GEMINI_APPROVAL_MODE=plan
# Desativa extensões da Gemini CLI para reduzir bootstrap e timeout
GEMINI_DISABLE_EXTENSIONS=true

# Claude CLI para fallback de sumarização
# Pode usar `CLAUDE_API` ou `ANTHROPIC_API_KEY`
CLAUDE_CLI_PATH=claude
CLAUDE_MODEL=
CLAUDE_API=

HTTP_TIMEOUT_MS=15000
HTTP_MAX_ATTEMPTS=3
HTTP_RETRY_BASE_MS=600
# Após N erros 403 na mesma fonte, pausa a fonte no ciclo atual
SOURCE_403_PAUSE_THRESHOLD=3
ROBOTS_RESPECT=true
ROBOTS_USER_AGENT=news-anime-monitor
ROBOTS_STRICT=false
ROBOTS_CACHE_TTL_MS=21600000
ROBOTS_FAILURE_TTL_MS=900000
ROBOTS_FETCH_ATTEMPTS=2
# Cookie opcional para Anime News Network (se o site exigir)
ANIMENEWSNETWORK_COOKIE=
# Alias opcional (retrocompatibilidade)
ANN_COOKIE=
# Cookie opcional para GameSpot (se o site exigir)
GAMESPOT_COOKIE=

# Controles de custo/volume (opcional)
SUMMARY_MAX_INPUT_CHARS=12000
ARTICLE_PROCESS_CONCURRENCY=1
IN_MEMORY_MAX_ARTICLES=0

# Fontes monitoradas (opcional)
# IDs disponíveis: animenew, animecorner, animenewsnetwork
NEWS_SOURCE_IDS=animenew,animecorner,animenewsnetwork,crunchyrollnews,myanimelist,anitrendz,otakuusa,animeherald,animeuknews,otakunews,siliconera

# Limites de coleta/processamento (opcional)
MAX_ITEMS_PER_SOURCE=50
MAX_SITEMAPS_PER_SOURCE=5
MAX_NEW_ARTICLES_PER_CYCLE=100
MAX_MONITOR_LOG_ITEMS=100
API_DEFAULT_LIMIT=50
API_MAX_LIMIT=200

# Segurança de API
CORS_ALLOWED_ORIGINS=https://animeradar.shop,https://www.animeradar.shop,http://localhost:3010,http://127.0.0.1:3010
RATE_LIMIT_WINDOW_MS=60000
# Perfis recomendados:
# Produção (mais conservador): RATE_LIMIT_MAX=120, READ_RATE_LIMIT_MAX=80, DEBUG_RATE_LIMIT_MAX=20
# Dev/local (mais flexível): RATE_LIMIT_MAX=500, READ_RATE_LIMIT_MAX=300, DEBUG_RATE_LIMIT_MAX=120
RATE_LIMIT_MAX=120
READ_RATE_LIMIT_MAX=80
DEBUG_RATE_LIMIT_MAX=20
CACHE_TTL_SECONDS=45
CACHE_SWR_SECONDS=120
CACHE_MAX_ENTRIES=2000
DEBUG_SOURCES_TOKEN=
DEBUG_API_TOKEN=
DEBUG_DASHBOARD_PASSWORD=
DEBUG_DASHBOARD_SECRET=
DEBUG_DASHBOARD_TTL_HOURS=8

# Observabilidade e alertas automáticos
ALERT_HISTORY_SIZE=72
ALERT_BASELINE_WINDOW=12
ALERT_FETCH_DROP_WARNING_RATIO=0.55
ALERT_FETCH_DROP_CRITICAL_RATIO=0.30
ALERT_ACCEPTED_DROP_WARNING_RATIO=0.55
ALERT_ACCEPTED_DROP_CRITICAL_RATIO=0.30
ALERT_PARSE_ERROR_WARNING_RATE=0.10
ALERT_PARSE_ERROR_CRITICAL_RATE=0.30
ALERT_REJECT_SPIKE_MULTIPLIER=2
ALERT_REJECT_SPIKE_MIN_DELTA=0.20
ALERT_DURATION_SPIKE_MULTIPLIER=2
ALERT_DURATION_SPIKE_MIN_MS=2000

# Descoberta automática de novos domínios candidatos
ENABLE_AUTO_DISCOVERY=false
AUTO_DISCOVERY_MIN_INTERVAL_MS=21600000
AUTO_DISCOVERY_TOP=80
AUTO_DISCOVERY_THRESHOLD=75
AUTO_DISCOVERY_ARTICLE_SAMPLE=40
AUTO_DISCOVERY_TOP_PER_QUERY=20

# MySQL
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=news-anime
DB_POOL_LIMIT=10
